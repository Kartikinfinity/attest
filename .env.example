# === ATTEST — Environment Variables ===
# Copy this file to .env and fill in real values.
# NEVER commit .env — it is excluded by .gitignore.

# TrueForge
TRUEFORGE_BASE_URL=http://localhost:8790

# Model provider (the actual API key/endpoint is configured via TrueForge
# Settings → Models, not here -- these two vars only select WHICH already-
# configured model the attest-auditor agent uses, and cap its agent-loop
# iterations. Switching providers -- including pointing at a local DGX
# Spark inference endpoint registered in TrueForge as a `custom` model
# provider -- is just changing this one string, no code change needed.
# ATTEST_MODEL_NAME=anthropic/claude-sonnet-4-6
# ATTEST_MODEL_NAME=google-gemini/gemini-3-6-flash
# ATTEST_MODEL_NAME=custom/dgx-spark-local
# ATTEST_ITERATION_LIMIT=60

# Daytona sandbox (configure via TrueForge Settings → Sandbox providers)
# DAYTONA_API_KEY=

# App
PORT=3000
NODE_ENV=development
