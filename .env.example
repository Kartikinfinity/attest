# === ATTEST — Environment Variables ===
# Copy this file to .env and fill in real values.
# NEVER commit .env — it is excluded by .gitignore.

# TrueForge
TRUEFORGE_BASE_URL=http://localhost:8790

# Model provider (used by TrueForge, not directly by Attest)
# Configure via TrueForge Settings → Models instead of here,
# unless running in headless/CI mode.

# Daytona sandbox (configure via TrueForge Settings → Sandbox providers)
# DAYTONA_API_KEY=

# App
PORT=3000
NODE_ENV=development
